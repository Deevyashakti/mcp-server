MONGODB_URI=mongodb://localhost:27017/deevyashakti
DB_NAME=deevyashakti
# Server
PORT=5001
NODE_ENV=production

# Claude (Anthropic API)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# Login — any long random string (at least 32 characters)
JWT_SECRET=
JWT_EXPIRES_IN=8h

# DivOS users collection and field names used for login
AUTH_USERS_COLLECTION=users
AUTH_EMAIL_FIELD=email
AUTH_PASSWORD_FIELD=password
AUTH_ROLE_FIELD=role
AUTH_NAME_FIELD=name

# Roles that can read every collection (comma separated)
ADMIN_ROLES=admin,superadmin
# Collections nobody can read through the chat
BLOCKED_COLLECTIONS=sessions,tokens,otps,refreshtokens
