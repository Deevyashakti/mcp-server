{
  "name": "mcp-server",
  "private": true,
  "version": "1.0.0",
  "description": "DivOS chat — Vite frontend + Express API",
  "scripts": {
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "build": "npm run build --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "install:all": "npm install --include=dev --prefix frontend && npm install --prefix backend",
    "test": "node -e \"console.log('No tests yet'); process.exit(0);\""
  },
  "engines": {
    "node": ">=20"
  }
}
